# Optional settings for Talaria. All have sensible defaults; you don't need any of these.
# The launchers don't read this file. Set the ones you want in your shell before starting.

# Port the server listens on.
TALARIA_PORT=5178

# Where your profile, jobs, drafts and screenshots are stored.
# TALARIA_DATA_DIR=/path/to/talaria-data

# Set to 1 to hide the browser window while Talaria submits applications.
# TALARIA_HEADLESS=1

# Folder for the automation browser's sign-ins (defaults to data/browser-profile).
# TALARIA_BROWSER_PROFILE=/path/to/browser-profile

# Only read once, to bring over sign-ins from Hermes Agent (the AI program older versions of Talaria used),
# if you had moved its folder.
# HERMES_HOME=/path/to/hermes
